# VaultProxy Environment Configuration Example
# Copy to .env and configure for your environment: `cp .env.example .env`

# 1. Profile: 'development' (default, permissive local dev) or 'production' (enforces tokens & strict checks)
VAULT_PROFILE=development

# 2. Authentication: Required in production (minimum 24 characters)
VAULT_AUTH_TOKEN=

# 3. Upstream Provider Settings
# OpenAI, Ollama, LiteLLM, vLLM, or any OpenAI-compatible API base URL
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

# 4. SLM (Small Language Model) Contextual Detection
# Options: 'off' (default, deterministic rules only), 'ollama', or 'gemini'
GEMMA_BACKEND=off
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma2:2b
GEMINI_API_KEY=

# 5. Safety & Concurrency
STRICT_MODE=false
DEMO_MODE=false
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT_SECONDS=60.0
